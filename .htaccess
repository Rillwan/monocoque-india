# ==========================================================
# Monocoque India - .htaccess (security rules)
# Works on Apache and LiteSpeed (Hostinger). Put this file in public_html.
# ==========================================================

# 1. Do not list the files of a folder when there is no index file
Options -Indexes

# 2. Block direct browser access to private/config files.
#    PHP can still read them internally; visitors cannot open them.
<FilesMatch "^(mail-config\.php|mail-secrets(\.example)?\.php|\.user\.ini|\.gitignore|\.htaccess)$">
    Require all denied
</FilesMatch>

# 3. Block any hidden file or folder (names starting with a dot, e.g. .git)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ==========================================================
# Monocoque India - .htaccess
# Forces HTTPS and removes ".html" from page URLs.
# ==========================================================
RewriteEngine On

# 1. Always use HTTPS: send http:// visitors to https://
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Redirect /index.html to the root URL "/"
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]

# 3. Redirect old URLs ending in .html to the clean URL
#    Example: /about.html -> /about  (301 = permanent, keeps SEO value)
RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# 4. Serve the matching .html file for clean URLs
#    Example: a visit to /about loads about.html (the URL stays /about)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# 5. Remove a trailing slash from page URLs
#    Example: /about/ -> /about  (real folders such as /assets/ are not changed)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]